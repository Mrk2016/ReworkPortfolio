---

// Definir tipos de iconos
type IconType = 'monitor' | 'server' | 'shopping-cart' | 'database' | 'brain';
type AccentKey = 'green';

interface Technology {
  name: string;
  tier: 1 | 2 | 3 | 4; // 1: Básico, 2: Intermedio, 3: Avanzado, 4: Experto
}

interface SkillGroup {
  category: string;
  icon: IconType;
  description: string;
  accent: AccentKey;
  highlight: string;
  technologies: Technology[];
}

const tierLabels: Record<number, string> = {
  1: "Básico",
  2: "Intermedio",
  3: "Avanzado",
  4: "Experto",
};

interface AccentTheme {
  iconBg: string;
  iconText: string;
  border: string;
  hoverBorder: string;
  dot: string;
  techText: string;
  chipBg: string;
  chipBorder: string;
  chipHoverBg: string;
}

// Un único acento (verde de marca) para todas las categorías: la diferenciación
// entre tarjetas queda en el ícono, el título y la descripción, no en el color.
const accentThemes: Record<AccentKey, AccentTheme> = {
  green: {
    iconBg: "from-green-500/20 to-green-600/20",
    iconText: "text-green-500",
    border: "border-white/10",
    hoverBorder: "hover:border-green-500/30",
    dot: "bg-green-500",
    techText: "text-green-400",
    chipBg: "bg-green-500/10",
    chipBorder: "border-green-500/20",
    chipHoverBg: "hover:bg-green-500/20",
  },
};

const skills: SkillGroup[] = [
  {
    category: "Stack IA & LLMs",
    icon: "brain",
    description: "Integración de modelos de lenguaje locales, pipelines RAG y automatización con IA",
    accent: "green",
    highlight: "Prompt Engineering",
    technologies: [
      { name: "Ollama", tier: 3 },
      { name: "Prompt Engineering", tier: 4 },
      { name: "RAG", tier: 3 },
      { name: "Pipelines", tier: 3 },
      { name: "Creación de Tools", tier: 3 },
      { name: "MCP", tier: 2 },
      { name: "N8N", tier: 3 },
      { name: "Open WebUI", tier: 2 }
    ]
  },
  {
    category: "Frontend Development",
    icon: "monitor",
    description: "Interfaces modernas y experiencias de usuario excepcionales",
    accent: "green",
    highlight: "JavaScript",
    technologies: [
      { name: "React", tier: 3 },
      { name: "Astro", tier: 4 },
      { name: "TypeScript", tier: 3 },
      { name: "JavaScript", tier: 4 },
      { name: "Tailwind CSS", tier: 4 },
      { name: "SASS", tier: 3 }
    ]
  },
  {
    category: "Backend Development",
    icon: "server",
    description: "APIs robustas y arquitecturas escalables",
    accent: "green",
    highlight: "PHP",
    technologies: [
      { name: "Node.js", tier: 4 },
      { name: "Python", tier: 3 },
      { name: "PHP", tier: 4 },
      { name: "Express", tier: 4 },
      { name: "REST APIs", tier: 4 }
    ]
  },
  {
    category: "WordPress & E-commerce",
    icon: "shopping-cart",
    description: "Soluciones completas de comercio electrónico",
    accent: "green",
    highlight: "WooCommerce",
    technologies: [
      { name: "WordPress", tier: 4 },
      { name: "WooCommerce", tier: 4 },
      { name: "Custom Themes", tier: 4 },
      { name: "Plugin Development", tier: 4 },
      { name: "ACF", tier: 4 },
      { name: "Elementor", tier: 4 }
    ]
  },
  {
    category: "Database & DevOps",
    icon: "database",
    description: "Gestión de datos y despliegue en la nube",
    accent: "green",
    highlight: "MySQL",
    technologies: [
      { name: "MongoDB", tier: 3 },
      { name: "MariaDB", tier: 3 },
      { name: "MySQL", tier: 4 },
      { name: "AWS", tier: 2 },
      { name: "Docker", tier: 2 },
      { name: "Git", tier: 4 }
    ]
  }
];

// Iconos SVG con tipado
const icons: Record<IconType, string> = {
  monitor: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
  </svg>`,
  server: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
  </svg>`,
  "shopping-cart": `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
  </svg>`,
  database: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
  </svg>`,
  brain: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
  </svg>`
};
---

<section id="skills" class="px-[5%] py-20 max-w-7xl mx-auto">
  <!-- Header Section -->
  <div class="text-center mb-16">
    <div class="inline-flex items-center gap-2 bg-green-500/10 text-green-500 px-4 py-2 rounded-full text-sm font-medium mb-6 border border-green-500/20">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
      Tecnologías y Herramientas
    </div>
    <h2 class="text-5xl font-bold mb-6 text-gradient">
      Stack Tecnológico
    </h2>
    <p class="text-xl text-gray-400 max-w-3xl mx-auto leading-relaxed">
      Dominio completo del ecosistema web moderno, desde interfaces interactivas hasta infraestructura robusta y soluciones de e-commerce escalables.
    </p>
  </div>

  <!-- Filter Options -->
  <div class="flex justify-center mb-12">
    <div class="flex flex-wrap gap-3 bg-gray-800/30 p-2 rounded-2xl border border-white/10">
      <button class="skills-filter-btn active px-6 py-2 rounded-xl text-sm font-medium transition-all duration-300" data-filter="all">
        Todas
      </button>
      <button class="skills-filter-btn px-6 py-2 rounded-xl text-sm font-medium transition-all duration-300" data-filter="Stack IA & LLMs">
        Stack IA
      </button>
      <button class="skills-filter-btn px-6 py-2 rounded-xl text-sm font-medium transition-all duration-300" data-filter="Frontend Development">
        Frontend
      </button>
      <button class="skills-filter-btn px-6 py-2 rounded-xl text-sm font-medium transition-all duration-300" data-filter="Backend Development">
        Backend
      </button>
      <button class="skills-filter-btn px-6 py-2 rounded-xl text-sm font-medium transition-all duration-300" data-filter="WordPress &amp; E-commerce">
        WordPress
      </button>
      <button class="skills-filter-btn px-6 py-2 rounded-xl text-sm font-medium transition-all duration-300" data-filter="Database &amp; DevOps">
        Database
      </button>
    </div>
  </div>

  <!-- Skills Grid (incluye Stack IA & LLMs como una tarjeta más, mismo formato) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {skills.map((skillGroup, index) => {
      const accent = accentThemes[skillGroup.accent];
      return (
        <div
          class={`group glass rounded-3xl p-8 border ${accent.border} ${accent.hoverBorder} transition-all duration-500 hover:transform hover:scale-[1.02] skill-card`}
          data-category={skillGroup.category}
          style={`animation-delay: ${(index + 1) * 0.2}s`}
        >
          <!-- Header del skill group -->
          <div class="flex items-center gap-4 mb-6">
            <div class={`flex-shrink-0 w-16 h-16 bg-gradient-to-br ${accent.iconBg} rounded-2xl flex items-center justify-center ${accent.iconText} group-hover:scale-110 transition-transform duration-300`}>
              <Fragment set:html={icons[skillGroup.icon as IconType]} />
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white mb-1">
                {skillGroup.category}
              </h3>
              <p class="text-gray-400 text-sm leading-relaxed">
                {skillGroup.description}
              </p>
            </div>
          </div>

          <!-- Technologies: chips compactos con nivel indicado por puntos -->
          <div class="flex flex-wrap gap-3">
            {skillGroup.technologies.map((tech) => {
              const label = tierLabels[tech.tier];
              return (
                <div
                  class={`tech-chip flex items-center gap-2 ${accent.techText} ${accent.chipBg} ${accent.chipBorder} ${accent.chipHoverBg} px-4 py-2 rounded-full text-sm border transition-all duration-300`}
                  role="img"
                  aria-label={`${tech.name}: ${label}`}
                >
                  <span class="font-medium">{tech.name}</span>
                  <span class="tier-dots" aria-hidden="true">
                    {[1, 2, 3, 4].map((n) => (
                      <span class={`tier-dot ${n <= tech.tier ? "filled" : ""}`}></span>
                    ))}
                  </span>
                </div>
              );
            })}
          </div>

          <!-- Footer stats -->
          <div class="mt-8 pt-6 border-t border-white/10">
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">
                {skillGroup.technologies.length} tecnologías
              </span>
              <div class={`flex items-center gap-2 ${accent.iconText}`}>
                <div class={`w-2 h-2 ${accent.dot} rounded-full animate-pulse`}></div>
                <span class="font-medium">Punto fuerte: {skillGroup.highlight}</span>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>

</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.skills-filter-btn');
    const skillCards = document.querySelectorAll<HTMLElement>('.skill-card[data-category]');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        if (!filter) return;

        filterButtons.forEach((btn) => btn.classList.remove('active'));
        button.classList.add('active');

        skillCards.forEach((card, index) => {
          const category = card.getAttribute('data-category');
          const shouldShow = filter === 'all' || category === filter;

          if (shouldShow) {
            card.style.display = 'block';
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            }, index * 80);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
              card.style.display = 'none';
            }, 300);
          }
        });
      });
    });
  });
</script>

<style>
  /* Animaciones de entrada */
  .skill-card {
    opacity: 0;
    transform: translateY(30px);
    animation: slideInUp 0.6s ease-out forwards;
  }

  @keyframes slideInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Chips de tecnología */
  .tech-chip {
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(34, 197, 94, 0.1);
  }

  .tech-chip:hover {
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.2);
    transform: translateY(-1px);
  }

  /* Puntos de nivel dentro del chip (reemplazan la barra de porcentaje) */
  .tier-dots {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-left: 2px;
  }

  .tier-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
  }

  .tier-dot.filled {
    background: currentColor;
    border-color: currentColor;
  }

  /* Filtros */
  .skills-filter-btn {
    color: #9ca3af;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .skills-filter-btn:hover,
  .skills-filter-btn.active {
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
  }

  /* Modo claro */
  html.light .skill-card {
    background: rgba(253, 251, 246,0.8);
    border: 1px solid rgba(34, 197, 94, 0.15);
  }

  html.light .text-white {
    color: #1f2937 !important;
  }

  html.light .text-gray-400 {
    color: #6b7280 !important;
  }

  html.light .text-gray-500 {
    color: #9ca3af !important;
  }

  html.light .bg-gray-800 {
    background-color: #e5e7eb !important;
  }

  html.light .tech-chip {
    background: rgba(34, 197, 94, 0.15) !important;
    border-color: rgba(34, 197, 94, 0.3) !important;
    color: #059669 !important;
    box-shadow: 0 2px 8px rgba(34, 197, 94, 0.15);
  }

  html.light .tech-chip:hover {
    background: rgba(34, 197, 94, 0.25) !important;
    border-color: rgba(34, 197, 94, 0.4) !important;
  }

  html.light .tier-dot {
    border-color: rgba(0, 0, 0, 0.3);
  }

  html.light .tier-dot.filled {
    border-color: #059669;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .skill-card {
      padding: 1.5rem;
    }

    .skill-card h3 {
      font-size: 1.25rem;
    }

    .skill-card .w-16.h-16 {
      width: 3rem;
      height: 3rem;
    }
  }
</style>
